import { katex } from '@mdit/plugin-katex'
import { withMermaid } from 'vitepress-plugin-mermaid'
import generated from './generated/bundles.json'

// one sidebar for the documentation, in reading order: the "previous" and "next" links at the bottom of a page
// follow it, so the documentation reads from the first page to the last. Each bundle gets its own sidebar,
// generated by tools/site_sync.py from the wiki.
const docs = [
  {
    text: 'Start here',
    items: [
      { text: 'Introduction', link: '/guide/' },
      { text: 'Getting started', link: '/guide/getting-started' },
      { text: 'How a bundle works', link: '/guide/concepts' },
    ],
  },
  {
    text: 'Tutorial',
    items: [
      { text: 'Overview', link: '/manual/' },
      { text: '1. Reading a bundle', link: '/manual/tutorial/01-reading' },
      { text: '2. Asking Claude', link: '/manual/tutorial/02-consulting' },
      { text: '3. A bundle of your own', link: '/manual/tutorial/03-new-bundle' },
      { text: '4. The first ingestion', link: '/manual/tutorial/04-ingestion' },
      { text: '5. The citation record', link: '/manual/tutorial/05-citations' },
      { text: '6. Keeping it honest', link: '/manual/tutorial/06-quality' },
      { text: '7. Publishing', link: '/manual/tutorial/07-publishing' },
    ],
  },
  {
    text: 'Recipes',
    items: [{ text: 'Cookbook', link: '/manual/cookbook' }],
  },
  {
    text: 'Reference',
    items: [
      { text: 'Page types and frontmatter', link: '/reference/page-types' },
      { text: 'Writing rules', link: '/reference/conventions' },
      { text: 'Bibliography format', link: '/reference/bibliography' },
      { text: 'Tools', link: '/reference/tools' },
      { text: 'Constitution', link: '/reference/constitution' },
      { text: 'Decision record', link: '/reference/decisions' },
    ],
  },
  {
    text: 'Project',
    items: [{ text: 'Contributing', link: '/project/contributing' }],
  },
]

const bundles = [
  {
    text: 'Bundles',
    items: [{ text: 'All bundles and the bundle map', link: '/bundles/' }, ...generated.nav],
  },
]

export default withMermaid({
  title: 'llm-wiki',
  description: 'LLM-compiled scientific knowledge bundles in the Open Knowledge Format',
  base: '/llm-wiki/',
  cleanUrls: true,
  // the citation records are published as files (public/bundles/<slug>/bibliography.bib), which the checker does not see
  ignoreDeadLinks: [/\.bib$/],
  lastUpdated: true,
  markdown: {
    // KaTeX at build time: the wiki's math law is KaTeX syntax ($...$, $$...$$), so the site doubles as its check.
    // A formula KaTeX cannot parse renders in red (class katex-error) instead of failing the whole build.
    config: (md) => {
      md.use(katex, { delimiters: 'dollars', throwOnError: false, logger: () => 'ignore' })
      // KaTeX keeps the TeX source in a MathML annotation, and TeX braces ({{ ... }}) are Vue interpolation:
      // v-pre keeps Vue's template compiler out of every formula
      for (const rule of ['math_inline', 'math_block']) {
        const render = md.renderer.rules[rule]!
        md.renderer.rules[rule] = (...args) => {
          const html = render(...args)
          return rule === 'math_inline' ? `<span v-pre>${html}</span>` : `<div v-pre>${html}</div>`
        }
      }
    },
  },
  themeConfig: {
    nav: [
      { text: 'Home', link: '/' },
      { text: 'Start here', link: '/guide/', activeMatch: '^/guide/' },
      { text: 'Tutorial', link: '/manual/tutorial/01-reading', activeMatch: '^/manual/(index|tutorial/)' },
      { text: 'Cookbook', link: '/manual/cookbook', activeMatch: '^/manual/cookbook' },
      { text: 'Reference', link: '/reference/page-types', activeMatch: '^/reference/' },
      {
        text: 'Bundles',
        activeMatch: '^/bundles/',
        items: [{ text: 'All bundles and the bundle map', link: '/bundles/' }, ...generated.nav],
      },
    ],
    sidebar: {
      '/guide/': docs,
      '/manual/': docs,
      '/reference/': docs,
      '/project/': docs,
      ...generated.sidebars,
      '/bundles/': bundles,
    },
    outline: { level: [2, 3] },
    search: {
      provider: 'local',
      options: {
        // the generated bibliographies hold thousands of entries each: searching them drowns every query
        _render(src, env, md) {
          if (env.relativePath.endsWith('/bibliography.md')) return ''
          return md.render(src, env)
        },
      },
    },
    socialLinks: [{ icon: 'github', link: 'https://github.com/szaghi/llm-wiki' }],
    editLink: {
      pattern: ({ filePath, frontmatter }) =>
        frontmatter.bundle && frontmatter.wikiPath
          ? `https://github.com/szaghi/llm-wiki/blob/main/${frontmatter.bundle}/wiki/${frontmatter.wikiPath}`
          : `https://github.com/szaghi/llm-wiki/edit/main/docs/${filePath}`,
      text: 'View the source on GitHub',
    },
    footer: {
      message: 'Wiki content compiled by Claude from the sources each page cites; every claim carries its citation.',
    },
  },
  mermaid: {},
  vite: {
    // es2022 needs no syntax lowering of what mermaid emits (see FLAP's docs config)
    build: {
      target: 'es2022',
      chunkSizeWarningLimit: 4000,
    },
  },
})
